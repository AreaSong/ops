  "services": {
    "areaforge": {
      "name": "areaforge",
      "objectId": "service:areaforge",
      "metadata": {
        "type": "service",
        "environment": "production",
        "owner": "operations",
        "criticality": "important",
        "lifecycle": "active",
        "maturity": "manual_approval"
      },
      "displayName": "AreaForge",
      "description": "AreaForge Web 与 PostgreSQL",
      "template": "custom",
      "adapterRef": "areaforge-v1",
      "tenantId": "production",
      "serverId": "losangeles",
      "capabilities": ["docker.compose", "backup", "restore", "restore-drill", "lifecycle"],
      "statePolicy": {
        "defaultDesired": "running",
        "maintenanceTtlSeconds": 14400,
        "drainTimeoutSeconds": 300,
        "autoReconcile": false
      },
      "trafficPolicy": {
        "adapterPath": "/usr/local/libexec/areasong-ops/adapters/nginx-traffic.sh",
        "siteFile": "/etc/nginx/sites-enabled/forge.areasong.top.conf",
        "includeFile": "/etc/nginx/snippets/areasong-ops/areaforge-traffic.conf",
        "hostname": "forge.areasong.top",
        "maintenanceFile": "/etc/nginx/snippets/areasong-ops/areaforge-maintenance.conf",
        "marker": "include /etc/nginx/snippets/areasong-ops/areaforge-traffic.conf;",
        "drainTimeoutSeconds": 300
      },
      "recoveryPointPolicy": {
        "requiredArtifactRoles": ["postgres-areaforge", "volume-areaforge-uploads", "volume-areaforge-ops-state"],
        "recoverableSeconds": 604800
      },
      "autoUpdate": {
        "enabled": false,
        "channel": "stable",
        "maintenanceWindow": "02:00-04:00",
        "canaryPercent": 10,
        "maxUnavailable": 1,
        "requireBackup": true,
        "requireApproval": true,
        "rollbackOnAlert": true,
        "observationSeconds": 900
      },
      "alertPolicy": {
        "matchers": {"service": "areaforge"},
        "blockingAlerts": [
          "AppHttpProbeFailed",
          "AppBlackboxTargetDown",
          "BusinessHttpProbeFailed",
          "BusinessBlackboxTargetDown",
          "BusinessHttp5xxHigh",
          "SyntheticSloFastBurnCritical"
        ],
        "maintenanceAlerts": ["AppHttpProbeFailed", "BusinessHttpProbeFailed", "BusinessHttp5xxHigh"]
      },
      "actions": {
        "inspect": {
          "name": "inspect",
          "displayName": "执行前检查",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["inspect"],
          "timeoutSeconds": 30,
          "impact": "仅读取容器、健康端点和版本身份。",
          "rollback": "没有变更，无需回滚。",
          "scope": "AreaForge Web 与 PostgreSQL 运行状态"
        },
        "check": {
          "name": "check",
          "displayName": "检查更新",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["discover"],
          "timeoutSeconds": 120,
          "impact": "下载并验证签名发布 manifest，不改变业务容器。",
          "rollback": "没有业务变更，无需回滚。",
          "scope": "AreaForge 签名发布元数据"
        },
        "backup": {
          "name": "backup",
          "displayName": "立即备份",
          "enabled": true,
          "risk": "low",
          "targetMode": "none",
          "steps": ["preflight", "backup", "verify"],
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "verify": {"effect": "observe", "failurePolicy": "fail"}
          },
          "timeoutSeconds": 3600,
          "confirmationTemplate": "备份 {service}",
          "impact": "执行现有 PostgreSQL 与卷分类备份，可能增加短时磁盘和 IO 负载。",
          "rollback": "备份失败不会修改业务数据；保留失败记录并核对现有备份。",
          "scope": "宿主机 PostgreSQL 与应用卷分类备份，不是单一服务快照"
        },
        "restart": {
          "name": "restart",
          "displayName": "重启 Web",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "restart", "health", "smoke"],
          "observationSeconds": 300,
          "timeoutSeconds": 600,
          "confirmationTemplate": "重启 {service}",
          "impact": "只重建 AreaForge Web，预计产生短暂请求中断；PostgreSQL 不重启。",
          "rollback": "重启不改变版本；失败时停止自动处理并进入人工核对。",
          "scope": "仅 AreaForge Web 容器"
        },
        "update": {
          "name": "update",
          "displayName": "更新版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "signed_release_tag",
          "readinessGate": "prepared_release",
          "steps": ["preflight", "backup", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "apply": {"effect": "data_mutation", "requiresRecoveryPoint": true, "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "health": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "smoke": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "identity": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"}
          },
          "timeoutSeconds": 7200,
          "confirmationTemplate": "更新 {service} 到 {target}",
          "impact": "验证签名发布、执行 fresh backup、迁移并只重建 Web，期间可能短暂中断。",
          "rollback": "原生事务 updater 先内部回滚；外层失败再恢复更新前 Compose 与镜像，并对迁移状态做保守标记。",
          "scope": "AreaForge Web、必要数据库迁移与两份 Compose"
        },
        "rollback": {
          "name": "rollback",
          "displayName": "回滚版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "controlled_rollback",
          "steps": ["preflight", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "timeoutSeconds": 3600,
          "confirmationTemplate": "回滚 {service} 使用任务 {target}",
          "impact": "恢复所选受控更新任务保存的更新前应用身份；数据库不会自动恢复。",
          "rollback": "回滚本身失败时立即停止，标记恢复状态不确定并告警。",
          "scope": "AreaForge Web 与 Compose；不执行数据库恢复"
        },
        "restore-drill": {
          "name": "restore-drill",
          "displayName": "恢复演练",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "drill", "verify"],
          "timeoutSeconds": 7200,
          "confirmationTemplate": "演练恢复 {service}",
          "impact": "在隔离环境恢复最近备份，增加临时磁盘、CPU 与数据库 IO，不切换生产数据。",
          "rollback": "演练环境失败后清理隔离资源，生产数据库与流量保持不变。",
          "scope": "AreaForge 隔离恢复环境"
        },
        "restore": {
          "name": "restore",
          "displayName": "生产恢复",
          "enabled": true,
          "risk": "high",
          "targetMode": "none",
          "steps": ["preflight", "quiesce", "restore", "verify", "resume"],
          "observationSeconds": 900,
          "phaseSemantics": {
            "preflight": {"effect": "observe", "requiresRecoveryPoint": true, "failurePolicy": "fail"},
            "quiesce": {"effect": "runtime_mutation", "requiresRecoveryPoint": true, "failurePolicy": "needs_attention"},
            "restore": {"effect": "data_mutation", "requiresRecoveryPoint": true, "failurePolicy": "needs_attention"},
            "verify": {"effect": "observe", "requiresRecoveryPoint": true, "failurePolicy": "needs_attention"},
            "resume": {"effect": "runtime_mutation", "requiresRecoveryPoint": true, "failurePolicy": "needs_attention"}
          },
          "timeoutSeconds": 7200,
          "confirmationTemplate": "恢复 {service} 使用恢复点 {target}",
          "impact": "停止 AreaForge Web，使用所选恢复点覆盖 PostgreSQL、上传卷与 ops-state，再验证并恢复服务。",
          "rollback": "生产恢复不自动回滚数据库；任一变更阶段失败都保持现场并进入人工核对。",
          "scope": "AreaForge PostgreSQL、上传卷、ops-state 与 Web 可用性"
        }
      }
    },
