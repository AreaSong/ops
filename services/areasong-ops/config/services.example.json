{
  "schemaVersion": 4,
  "adapters": {
    "areaforge-v1": {
      "path": "/usr/local/libexec/areasong-ops/adapters/areaforge.sh",
      "allowedTypes": ["service"]
    },
    "compose-service-v1": {
      "path": "/usr/local/libexec/areasong-ops/adapters/compose-service.sh",
      "allowedTypes": ["service"]
    },
    "automatic-task-v1": {
      "path": "/usr/local/libexec/areasong-ops/adapters/automatic-task.sh",
      "allowedTypes": ["automatic_task"]
    }
  },
  "services": {
    "areaforge": {
      "name": "areaforge",
      "objectId": "service:areaforge",
      "metadata": {
        "type": "service",
        "environment": "production",
        "owner": "operations",
        "criticality": "important",
        "lifecycle": "active",
        "maturity": "manual_approval"
      },
      "displayName": "AreaForge",
      "description": "AreaForge Web 与 PostgreSQL",
      "template": "custom",
      "adapterRef": "areaforge-v1",
      "alertPolicy": {
        "matchers": {"service": "areaforge"},
        "blockingAlerts": [
          "AppHttpProbeFailed",
          "AppBlackboxTargetDown",
          "BusinessHttpProbeFailed",
          "BusinessBlackboxTargetDown",
          "BusinessHttp5xxHigh",
          "SyntheticSloFastBurnCritical"
        ],
        "maintenanceAlerts": ["AppHttpProbeFailed", "BusinessHttpProbeFailed", "BusinessHttp5xxHigh"]
      },
      "actions": {
        "inspect": {
          "name": "inspect",
          "displayName": "执行前检查",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["inspect"],
          "timeoutSeconds": 30,
          "impact": "仅读取容器、健康端点和版本身份。",
          "rollback": "没有变更，无需回滚。",
          "scope": "AreaForge Web 与 PostgreSQL 运行状态"
        },
        "check": {
          "name": "check",
          "displayName": "检查更新",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["discover"],
          "timeoutSeconds": 120,
          "impact": "下载并验证签名发布 manifest，不改变业务容器。",
          "rollback": "没有业务变更，无需回滚。",
          "scope": "AreaForge 签名发布元数据"
        },
        "backup": {
          "name": "backup",
          "displayName": "立即备份",
          "enabled": true,
          "risk": "low",
          "targetMode": "none",
          "steps": ["preflight", "backup", "verify"],
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "verify": {"effect": "observe", "failurePolicy": "fail"}
          },
          "timeoutSeconds": 3600,
          "confirmationTemplate": "备份 {service}",
          "impact": "执行现有 PostgreSQL 与卷分类备份，可能增加短时磁盘和 IO 负载。",
          "rollback": "备份失败不会修改业务数据；保留失败记录并核对现有备份。",
          "scope": "宿主机 PostgreSQL 与应用卷分类备份，不是单一服务快照"
        },
        "restart": {
          "name": "restart",
          "displayName": "重启 Web",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "restart", "health", "smoke"],
          "observationSeconds": 300,
          "timeoutSeconds": 600,
          "confirmationTemplate": "重启 {service}",
          "impact": "只重建 AreaForge Web，预计产生短暂请求中断；PostgreSQL 不重启。",
          "rollback": "重启不改变版本；失败时停止自动处理并进入人工核对。",
          "scope": "仅 AreaForge Web 容器"
        },
        "update": {
          "name": "update",
          "displayName": "更新版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "signed_release_tag",
          "readinessGate": "prepared_release",
          "steps": ["preflight", "backup", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "apply": {"effect": "data_mutation", "requiresRecoveryPoint": true, "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "health": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "smoke": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "identity": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"}
          },
          "timeoutSeconds": 7200,
          "confirmationTemplate": "更新 {service} 到 {target}",
          "impact": "验证签名发布、执行 fresh backup、迁移并只重建 Web，期间可能短暂中断。",
          "rollback": "原生事务 updater 先内部回滚；外层失败再恢复更新前 Compose 与镜像，并对迁移状态做保守标记。",
          "scope": "AreaForge Web、必要数据库迁移与两份 Compose"
        },
        "rollback": {
          "name": "rollback",
          "displayName": "回滚版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "controlled_rollback",
          "steps": ["preflight", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "timeoutSeconds": 3600,
          "confirmationTemplate": "回滚 {service} 使用任务 {target}",
          "impact": "恢复所选受控更新任务保存的更新前应用身份；数据库不会自动恢复。",
          "rollback": "回滚本身失败时立即停止，标记恢复状态不确定并告警。",
          "scope": "AreaForge Web 与 Compose；不执行数据库恢复"
        },
        "restore-drill": {
          "name": "restore-drill",
          "displayName": "恢复演练",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "drill", "verify"],
          "timeoutSeconds": 7200,
          "confirmationTemplate": "演练恢复 {service}",
          "impact": "在隔离环境恢复最近备份，增加临时磁盘、CPU 与数据库 IO，不切换生产数据。",
          "rollback": "演练环境失败后清理隔离资源，生产数据库与流量保持不变。",
          "scope": "AreaForge 隔离恢复环境"
        }
      }
    },
    "sub2api": {
      "name": "sub2api",
      "objectId": "service:sub2api",
      "metadata": {
        "type": "service",
        "environment": "production",
        "owner": "operations",
        "criticality": "critical",
        "lifecycle": "active",
        "maturity": "manual_approval"
      },
      "displayName": "Sub2API",
      "description": "Sub2API、PostgreSQL 与 Redis",
      "template": "compose-service-v1",
      "adapterRef": "compose-service-v1",
      "alertPolicy": {
        "matchers": {"service": "sub2api"},
        "blockingAlerts": [
          "AppHttpProbeFailed",
          "AppBlackboxTargetDown",
          "BusinessHttpProbeFailed",
          "BusinessBlackboxTargetDown",
          "BusinessHttp5xxHigh",
          "SyntheticSloFastBurnCritical"
        ],
        "maintenanceAlerts": ["AppHttpProbeFailed", "BusinessHttpProbeFailed", "BusinessHttp5xxHigh"]
      },
      "runtime": {
        "controlledCompose": "/opt/ops/services/sub2api/compose.yml",
        "runtimeCompose": "/opt/services/sub2api/compose.yml",
        "envFile": "/opt/services/sub2api/.env",
        "applicationService": "sub2api",
        "applicationContainer": "sub2api",
        "dependencyContainers": ["sub2api-postgres", "sub2api-redis"],
        "healthUrl": "http://127.0.0.1:8080/health",
        "releaseRepository": "Wei-Shaw/sub2api",
        "releaseCatalog": "/opt/ops/scripts/deploy/update-control/releases/sub2api.json",
        "preparedReleaseDir": "/var/lib/areasong-ops/prepared-releases/sub2api",
        "inspectExecutable": "/usr/local/libexec/areasong-ops/adapters/sub2api.sh",
        "backupExecutables": [
          "/opt/ops/scripts/backup/backup-postgres.sh",
          "/opt/ops/scripts/backup/backup-redis.sh",
          "/opt/ops/scripts/backup/backup-volumes.sh"
        ],
        "restoreDrillExecutable": "/opt/ops/scripts/backup/restore-sub2api-isolated.sh",
        "prepareExecutable": "/opt/ops/scripts/backup/restore-sub2api-isolated.sh",
        "updateExecutable": "/usr/local/libexec/areasong-ops/adapters/sub2api.sh"
      },
      "actions": {
        "inspect": {
          "name": "inspect",
          "displayName": "执行前检查",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["inspect"],
          "timeoutSeconds": 30,
          "impact": "仅读取容器、健康端点、迁移数量和版本身份。",
          "rollback": "没有变更，无需回滚。",
          "scope": "Sub2API、PostgreSQL 与 Redis 运行状态"
        },
        "check": {
          "name": "check",
          "displayName": "检查更新",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["discover"],
          "timeoutSeconds": 120,
          "impact": "读取 GitHub 最新发布和本地准备目录，不拉取或重建容器。",
          "rollback": "没有业务变更，无需回滚。",
          "scope": "Sub2API 发布元数据"
        },
        "backup": {
          "name": "backup",
          "displayName": "立即备份",
          "enabled": true,
          "risk": "low",
          "targetMode": "none",
          "steps": ["preflight", "backup", "verify"],
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "verify": {"effect": "observe", "failurePolicy": "fail"}
          },
          "timeoutSeconds": 3600,
          "confirmationTemplate": "备份 {service}",
          "impact": "执行现有 PostgreSQL、Redis 与卷分类备份，可能增加短时磁盘和 IO 负载。",
          "rollback": "备份失败不会修改业务数据；保留失败记录并核对现有备份。",
          "scope": "宿主机 PostgreSQL、Redis 与应用卷分类备份，不是单一服务快照"
        },
        "restart": {
          "name": "restart",
          "displayName": "重启应用",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "restart", "health", "smoke"],
          "observationSeconds": 300,
          "timeoutSeconds": 600,
          "confirmationTemplate": "重启 {service}",
          "impact": "只重建 Sub2API 应用，预计产生短暂请求中断；PostgreSQL 与 Redis 不重启。",
          "rollback": "重启不改变版本；失败时停止自动处理并进入人工核对。",
          "scope": "仅 Sub2API 应用容器"
        },
        "prepare": {
          "name": "prepare",
          "displayName": "准备发布",
          "enabled": true,
          "risk": "medium",
          "targetMode": "signed_release_tag",
          "steps": ["preflight", "backup", "drill", "verify", "publish"],
          "timeoutSeconds": 7200,
          "confirmationTemplate": "演练 {service} 发布 {target}",
          "impact": "使用 fresh backup 在无宿主机端口的隔离环境验证目标迁移和旧镜像兼容性，不更新生产应用。",
          "rollback": "失败时删除隔离容器、网络和工作目录，不修改生产数据库、Compose 或运行版本。",
          "scope": "Sub2API 隔离迁移与回滚兼容演练"
        },
        "update": {
          "name": "update",
          "displayName": "更新版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "signed_release_tag",
          "readinessGate": "prepared_release",
          "steps": ["preflight", "backup", "migration", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "backup": {"effect": "artifact_write", "producesRecoveryPoint": true, "failurePolicy": "fail"},
            "migration": {"effect": "observe", "requiresRecoveryPoint": true, "failurePolicy": "fail"},
            "apply": {"effect": "data_mutation", "requiresRecoveryPoint": true, "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "health": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "smoke": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"},
            "identity": {"effect": "observe", "failurePolicy": "rollback", "recoveryPhase": "rollback"}
          },
          "timeoutSeconds": 7200,
          "confirmationTemplate": "更新 {service} 到 {target}",
          "impact": "仅允许通过固定摘要、fresh backup、隔离迁移与旧镜像回滚演练的目标。",
          "rollback": "恢复更新前应用镜像与 Compose，不自动恢复数据库。",
          "scope": "Sub2API 应用与必要数据库迁移；PostgreSQL、Redis 容器不重建"
        },
        "rollback": {
          "name": "rollback",
          "displayName": "回滚版本",
          "enabled": true,
          "risk": "high",
          "targetMode": "controlled_rollback",
          "steps": ["preflight", "apply", "health", "smoke", "identity"],
          "observationSeconds": 900,
          "timeoutSeconds": 3600,
          "confirmationTemplate": "回滚 {service} 使用任务 {target}",
          "impact": "恢复所选受控更新任务保存的旧应用镜像；数据库 schema 保持更新后状态。",
          "rollback": "仅允许使用已演练旧镜像兼容新 schema 的来源任务；数据库恢复始终人工执行。",
          "scope": "仅 Sub2API 应用与两份 Compose；不重建 PostgreSQL、Redis"
        },
        "restore-drill": {
          "name": "restore-drill",
          "displayName": "恢复演练",
          "enabled": true,
          "risk": "medium",
          "targetMode": "none",
          "steps": ["preflight", "backup", "drill", "verify"],
          "timeoutSeconds": 7200,
          "confirmationTemplate": "演练恢复 {service}",
          "impact": "从最新完整备份集恢复 PostgreSQL、Redis 与应用卷并执行隔离健康检查。",
          "rollback": "失败时删除隔离资源；不执行生产数据库恢复。",
          "scope": "Sub2API 隔离恢复环境"
        }
      }
    }
  },
  "automaticTasks": {
    "runtime-snapshot": {
      "name": "runtime-snapshot",
      "objectId": "automatic-task:runtime-snapshot",
      "metadata": {
        "type": "automatic_task",
        "environment": "production",
        "owner": "operations",
        "criticality": "important",
        "lifecycle": "active",
        "maturity": "manual_approval"
      },
      "displayName": "运行资产快照",
      "description": "汇总受管资产、容器、端口和配置漂移状态。",
      "template": "automatic-task-v1",
      "adapterRef": "automatic-task-v1",
      "automaticTask": {
        "schedule": "每分钟",
        "scheduleSource": "cron",
        "freshnessSeconds": 180
      },
      "actions": {
        "inspect": {
          "name": "inspect",
          "displayName": "检查状态",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["inspect"],
          "timeoutSeconds": 30,
          "impact": "仅读取固定 cron、受信脚本和新鲜度指标。",
          "rollback": "没有变更，无需回滚。",
          "scope": "运行资产快照任务"
        },
        "rerun": {
          "name": "rerun",
          "displayName": "立即补跑",
          "enabled": true,
          "risk": "low",
          "targetMode": "none",
          "steps": ["preflight", "run", "verify"],
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "run": {"effect": "artifact_write", "failurePolicy": "fail"},
            "verify": {"effect": "observe", "failurePolicy": "fail"}
          },
          "timeoutSeconds": 120,
          "confirmationTemplate": "补跑 {service}",
          "impact": "执行固定运行资产采集器并原子刷新指标，不修改调度、服务版本或业务数据。",
          "rollback": "采集失败保留原指标文件并进入可重试失败状态。",
          "scope": "仅运行资产快照采集器"
        }
      }
    },
    "docker-metrics": {
      "name": "docker-metrics",
      "objectId": "automatic-task:docker-metrics",
      "metadata": {
        "type": "automatic_task",
        "environment": "production",
        "owner": "operations",
        "criticality": "important",
        "lifecycle": "active",
        "maturity": "manual_approval"
      },
      "displayName": "Docker 运行指标",
      "description": "采集受管容器身份、健康、资源边界和使用率。",
      "template": "automatic-task-v1",
      "adapterRef": "automatic-task-v1",
      "automaticTask": {
        "schedule": "每分钟",
        "scheduleSource": "cron",
        "freshnessSeconds": 180
      },
      "actions": {
        "inspect": {
          "name": "inspect",
          "displayName": "检查状态",
          "enabled": true,
          "risk": "read_only",
          "targetMode": "none",
          "steps": ["inspect"],
          "timeoutSeconds": 30,
          "impact": "仅读取固定 cron、受信脚本和新鲜度指标。",
          "rollback": "没有变更，无需回滚。",
          "scope": "Docker 运行指标任务"
        },
        "rerun": {
          "name": "rerun",
          "displayName": "立即补跑",
          "enabled": true,
          "risk": "low",
          "targetMode": "none",
          "steps": ["preflight", "run", "verify"],
          "phaseSemantics": {
            "preflight": {"effect": "observe", "failurePolicy": "fail"},
            "run": {"effect": "artifact_write", "failurePolicy": "fail"},
            "verify": {"effect": "observe", "failurePolicy": "fail"}
          },
          "timeoutSeconds": 120,
          "confirmationTemplate": "补跑 {service}",
          "impact": "执行固定 Docker 指标采集器并原子刷新指标，不重启或修改容器。",
          "rollback": "采集失败保留原指标文件并进入可重试失败状态。",
          "scope": "仅 Docker 运行指标采集器"
        }
      }
    }
  }
}
