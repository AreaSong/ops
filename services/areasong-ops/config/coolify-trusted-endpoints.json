      "id": "localhost-test",
      "endpoint": "http://127.0.0.1:8000",
      "description": "本地测试 Coolify 实例（仅用于开发）",
      "allowedServices": ["*"],
      "tokenFile": "/etc/areasong-ops/secrets/coolify-test.token"
    }
  },
  "allowedServiceUuids": {
    "6oqw6kcjzweijv6r9ux71zoe": "areasong-ops",
    "wu3zblpkvdjncfrlkqiavfrc": "resume-jadeai",
    "da5yxpvxkprxivcbkc9g27id": "account-vault-web",
    "cmajwelgaiyouyev0pzqk2j2": "account-vault-pg"
  }
}
