[Unit]
Description=AreaSong Ops privileged runner
Documentation=file:///opt/ops/services/areasong-ops/README.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=areasong-ops
UMask=0077
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g areasong-ops /var/lib/areasong-ops/tmp /var/lib/areasong-ops/cache /var/lib/areasong-ops/restore-drill
ExecStartPre=/usr/bin/install -d -m 0700 -o root -g root /var/lib/areasong-ops/credentials /var/lib/areasong-ops/credential-rollbacks
ExecStartPre=/usr/bin/install -d -m 0750 -o root -g areasong-ops /var/lib/areasong-ops/run
ExecStart=/usr/local/libexec/areasong-ops/areasong-ops-runner
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
StateDirectory=areasong-ops
StateDirectoryMode=0710
Environment=OPS_STATE_ROOT=/var/lib/areasong-ops
Environment=OPS_LEGACY_STATE_ROOT=/var/lib/ops/update-control
Environment=OPS_SERVICE_CATALOG=/etc/areasong-ops/services.json
Environment=OPS_RUNNER_SOCKET=/var/lib/areasong-ops/run/runner.sock
Environment=OPS_ALERTMANAGER_URL=http://127.0.0.1:9093
Environment=TMPDIR=/var/lib/areasong-ops/tmp
Environment=HOME=/var/lib/areasong-ops
Environment=XDG_CACHE_HOME=/var/lib/areasong-ops/cache
Environment=RESTORE_DRILL_WORK_ROOT=/var/lib/areasong-ops/restore-drill

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/var/lib/areasong-ops
ReadWritePaths=-/var/lib/ops/update-control
ReadWritePaths=/var/backups/ops
ReadWritePaths=/var/log/backup
ReadWritePaths=/var/lib/node_exporter/textfile_collector
ReadWritePaths=/opt/areaforge
ReadWritePaths=/opt/services/sub2api
ReadWritePaths=/opt/ops/services/areaforge
ReadWritePaths=/opt/ops/services/sub2api

[Install]
WantedBy=multi-user.target
