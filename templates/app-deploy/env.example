# Copy to /etc/__APP_NAME__/__APP_NAME__.env
# Set owner/permission:
#   sudo chown root:root /etc/__APP_NAME__/__APP_NAME__.env
#   sudo chmod 0600 /etc/__APP_NAME__/__APP_NAME__.env

APP_NAME=__APP_NAME__
NODE_ENV=production
PORT=__APP_PORT__

# Add project-specific variables below.
# Do not commit real secrets to Git.
# DATABASE_URL=
# REDIS_URL=
# JWT_SECRET=
# API_KEY=
