{
  "uid": "losangeles-services-backups",
  "title": "服务运行与备份",
  "description": "高密度：服务/备份 KPI + 压缩趋势。",
  "tags": [
    "LosAngeles",
    "backup",
    "nav-reliability",
    "services"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "本地备份完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(backup_set_last_success_timestamp[5m]) > 0",
        "step": "5m",
        "titleFormat": "本地备份完成",
        "tagKeys": "backup"
      },
      {
        "name": "R2 备份完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "expr": "changes(r2_backup_last_success_timestamp[5m]) > 0",
        "step": "5m",
        "titleFormat": "R2 备份完成",
        "tagKeys": "backup"
      },
      {
        "name": "R2 备份校验完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "purple",
        "expr": "changes(backup_set_r2_verify_last_success_timestamp[5m]) > 0",
        "step": "5m",
        "titleFormat": "R2 备份校验完成",
        "tagKeys": "backup"
      },
      {
        "name": "恢复演练完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "changes(areaforge_restore_drill_last_success_timestamp[5m]) > 0",
        "step": "5m",
        "titleFormat": "AreaForge 恢复演练完成",
        "tagKeys": "service"
      },
      {
        "name": "AreaSong Ops 恢复演练完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "expr": "changes(areasong_ops_restore_drill_last_success_timestamp_seconds[5m]) > 0",
        "step": "5m",
        "titleFormat": "AreaSong Ops 恢复演练完成",
        "tagKeys": "service"
      },
      {
        "name": "Sub2API 恢复演练完成",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "yellow",
        "expr": "changes(sub2api_restore_drill_last_success_timestamp_seconds[5m]) > 0",
        "step": "5m",
        "titleFormat": "Sub2API 恢复演练完成",
        "tagKeys": "service"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "即时 KPI",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 50,
      "type": "stat",
      "title": "HTTPS 探测",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "min(probe_success{job=\"blackbox_https\"}) or vector(0)",
          "legendFormat": "HTTPS 探测",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "进入应用健康",
              "url": "/d/losangeles-app-health/losangeles-app-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
