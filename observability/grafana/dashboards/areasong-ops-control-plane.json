{
  "annotations": {
    "list": [
      {
        "name": "控制面任务完成",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(areasong_ops_last_task_finished_timestamp_seconds[75s]) > 0",
        "step": "60s",
        "titleFormat": "{{service}} {{action}} {{state}}",
        "tagKeys": "service,action,state"
      },
      {
        "name": "控制面运行变更",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "label_replace(changes(docker_container_started_at_timestamp_seconds{name=\"areasong-ops-web\"}[75s]) > 0, \"event\", \"Web 部署/重建\", \"name\", \".*\") or label_replace(increase(docker_container_restart_count{name=\"areasong-ops-web\"}[75s]) > 0, \"event\", \"Web 自动重启\", \"name\", \".*\")",
        "step": "60s",
        "titleFormat": "{{event}}",
        "tagKeys": "event,service,name"
      },
      {
        "name": "控制面备份与恢复",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "expr": "label_replace(changes(backup_set_last_success_timestamp[5m]) > 0, \"event\", \"完整备份集完成\", \"__name__\", \".*\") or label_replace(changes(areasong_ops_restore_drill_last_success_timestamp_seconds[5m]) > 0, \"event\", \"控制面恢复演练完成\", \"__name__\", \".*\")",
        "step": "5m",
        "titleFormat": "{{event}}",
        "tagKeys": "event,service"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
