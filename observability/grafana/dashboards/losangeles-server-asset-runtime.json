                  "type": "value",
                  "options": {
                    "0": {
                      "text": "异常",
                      "color": "red"
                    },
                    "1": {
                      "text": "正常",
                      "color": "green"
                    }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "red",
                    "value": null
                  },
                  {
                    "color": "green",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "colorMode": "value",
