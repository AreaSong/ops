      "id": 5,
      "type": "timeseries",
      "title": "Redis 采集状态",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"redis\"}",
