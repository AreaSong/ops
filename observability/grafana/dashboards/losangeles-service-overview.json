      "id": 9,
      "type": "table",
      "title": "容器运行状态",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "expr": "docker_container_running",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
