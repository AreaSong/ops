    {
      "id": 43,
      "type": "table",
      "title": "需关注容器（重启/非健康/OOM）",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 3
      },
      "targets": [
        {
          "expr": "docker_container_restart_count",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "docker_container_health_status{status=\"healthy\"}",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "docker_container_oom_killed",
          "format": "table",
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "job": true,
          "job 1": true,
          "job 2": true,
          "job 3": true,
          "service 1": true,
          "service 2": true,
          "service 3": true,
          "status": true,
              "status 1": true,
              "status 2": true
            },
        "renameByName": {
          "name": "容器",
          "service": "服务",
          "Value #A": "重启次数",
              "Value #B": "健康(1=ok)",
              "Value #C": "OOM"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "重启次数",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              },
              {
                "fieldName": "健康(1=ok)",
                "config": {
                  "id": "lower",
                  "options": {
                    "value": 1
                  }
                }
              },
              {
                "fieldName": "OOM",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ],
            "type": "include",
            "match": "any"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
