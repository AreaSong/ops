{
  "uid": "losangeles-service-overview",
  "title": "服务总览",
  "description": "LosAngeles NOC 首页：异常优先入口、服务健康矩阵、待处理告警与短资源趋势。",
  "tags": [
    "LosAngeles",
    "nav-runtime",
    "noc",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "运行变更",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "label_replace(changes(docker_container_started_at_timestamp_seconds[75s]) > 0, \"event\", \"部署/重建 $1\", \"name\", \"(.*)\") or label_replace(increase(docker_container_restart_count[75s]) > 0, \"event\", \"自动重启 $1\", \"name\", \"(.*)\") or label_replace(changes(ops_config_drift[2m]) != 0, \"event\", \"配置漂移 $1\", \"name\", \"(.*)\")",
        "step": "60s",
        "titleFormat": "{{event}}",
        "tagKeys": "event,service,name,severity"
      },
      {
        "name": "备份与恢复",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "expr": "label_replace(changes(backup_set_last_success_timestamp[5m]) > 0, \"event\", \"备份完成\", \"__name__\", \".*\") or label_replace(changes(areaforge_restore_drill_last_success_timestamp[5m]) > 0, \"event\", \"恢复演练完成 $1\", \"source\", \"(.*)\")",
        "step": "5m",
        "titleFormat": "{{event}}",
        "tagKeys": "event,service,source"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "运行",
      "tags": [
        "nav-runtime"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "可靠性",
      "tags": [
        "nav-reliability"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "安全与审计",
      "tags": [
        "nav-governance"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "活动告警",
      "url": "/alerting/list",
      "icon": "bell",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "静默管理",
      "url": "/alerting/silences",
      "icon": "pause",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "外部存活监控",
      "url": "https://github.com/AreaSong/ops/actions/workflows/external-uptime.yml",
      "icon": "external link",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "当前需要处理",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "活动告警",
      "description": "分别显示当前严重和警告级别的 Prometheus firing 告警，避免用总数掩盖单条严重告警。",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"critical\"}) or vector(0)",
          "legendFormat": "严重",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "count(ALERTS{alertstate=\"firing\",severity=\"warning\"}) or vector(0)",
          "legendFormat": "警告",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "查看活动告警",
              "url": "/alerting/list?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "探测异常",
      "description": "按服务聚合外部与业务探测；探测抓取数据全部缺失时显示红色缺失状态。",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "count((min by (service) (probe_success{service!=\"\"}) == 0) or (min by (service) (up{job=~\"blackbox_.*\",job!=\"blackbox_exporter\",service!=\"\"}) == 0)) or on() (absent(up{job=~\"blackbox_.*\",job!=\"blackbox_exporter\",service!=\"\"}) * -1) or vector(0)",
          "legendFormat": "探测异常",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "探测数据缺失",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "进入应用健康",
              "url": "/d/losangeles-app-health/losangeles-app-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "停摆容器",
      "description": "仅在 Docker 指标采集成功且新鲜时统计停摆容器；采集失败、陈旧或缺失时显示红色缺失状态。",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "(count(docker_container_running == 0) and on() (min(docker_metrics_check_success) == 1) and on() (time() - max(docker_metrics_last_run_timestamp) <= 900)) or on() ((min(docker_metrics_check_success) == 0) * 0 - 1) or on() ((time() - max(docker_metrics_last_run_timestamp) > 900) * 0 - 1) or on() (absent(docker_metrics_check_success) * -1) or on() (absent(docker_metrics_last_run_timestamp) * -1) or vector(0)",
          "legendFormat": "停摆容器",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Docker 采集缺失",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "进入服务运行与备份",
              "url": "/d/losangeles-services-backups/losangeles-services-backups?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "备份超期",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "count((time() - backup_set_last_success_timestamp) > 24 * 3600) or on() (absent(backup_set_last_success_timestamp) * -1) or vector(0)",
          "legendFormat": "备份超期",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "links": [
            {
              "title": "进入服务运行与备份",
              "url": "/d/losangeles-services-backups/losangeles-services-backups?${__url_time_range}",
              "targetBlank": false
            }
          ],
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "备份数据缺失",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "统计超过 24 小时未完成的备份集；指标缺失时明确显示数据缺失。"
    },
    {
      "id": 101,
      "type": "row",
      "title": "影响范围与待处理事项",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 44,
      "type": "table",
      "title": "服务健康矩阵",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "min by (service) (probe_success{service!=\"\"})",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "min by (service) (last_over_time(service:synthetic_error_budget_remaining:ratio_30d[2h]) and on(service, journey) (last_over_time(service:synthetic_slo_coverage:ratio_30d[2h]) >= 0.95))",
          "format": "table",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "count by (service) (ALERTS{alertstate=\"firing\",service!=\"\"}) or (0 * min by (service) (probe_success{service!=\"\"})) or (0 * sum by (service) (docker_container_running))",
          "format": "table",
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (service) (docker_container_running)",
          "format": "table",
          "instant": true,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (service) (docker_container_health_status{status!=\"healthy\"} == 1) or (0 * sum by (service) (docker_container_running))",
          "format": "table",
          "instant": true,
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (service) (docker_container_oom_killed) or (0 * sum by (service) (docker_container_running))",
          "format": "table",
          "instant": true,
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "instance 5": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "job 5": true
            },
            "renameByName": {
              "service": "服务",
              "Value #A": "探测",
              "Value #B": "错误预算",
              "Value #C": "告警",
              "Value #D": "运行容器",
              "Value #E": "非健康",
              "Value #F": "OOM"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "center",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "探测"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red"
                      },
                      "1": {
                        "text": "UP",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "错误预算"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "N/A",
                        "color": "gray"
                      }
                    }
                  }
                ]
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.25
                    },
                    {
                      "color": "green",
                      "value": 0.5
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "告警"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "运行容器"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "非健康"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "OOM"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "告警",
            "desc": true
          },
          {
            "displayName": "非健康",
            "desc": true
          },
          {
            "displayName": "OOM",
            "desc": true
          },
          {
            "displayName": "探测",
            "desc": false
          },
          {
            "displayName": "服务",
            "desc": false
          }
        ],
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "按服务汇总探测、错误预算、活动告警、运行容器、非健康容器和 OOM 状态；空值表示该服务不适用对应信号。"
    },
    {
      "id": 45,
      "type": "table",
      "title": "待处理告警",
      "description": "直接列出 Prometheus 当前 firing 告警；无告警时显示一行正常状态，点击任意单元格进入活动告警。",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "label_replace(ALERTS{alertstate=\"firing\",severity=\"critical\"}, \"severity\", \"1-critical\", \"severity\", \"critical\") or label_replace(ALERTS{alertstate=\"firing\",severity=\"warning\"}, \"severity\", \"2-warning\", \"severity\", \"warning\") or label_replace(ALERTS{alertstate=\"firing\",severity!~\"critical|warning\"}, \"severity\", \"3-other\", \"__name__\", \".*\") or on() label_replace(label_replace(label_replace(absent(ALERTS{alertstate=\"firing\"}) * 0, \"alertname\", \"当前无活动告警\", \"alertstate\", \".*\"), \"severity\", \"4-normal\", \"alertstate\", \".*\"), \"service\", \"-\", \"alertstate\", \".*\")",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "alertstate": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "severity": 0,
              "service": 1,
              "alertname": 2,
              "Value": 3
