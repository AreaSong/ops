    },
    {
      "id": 1,
      "type": "stat",
      "title": "探测异常",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 2,
        "h": 3
      },
      "targets": [
        {
          "expr": "count(min by (service) (probe_success{service!=\"\"}) == 0) or vector(0)",
          "legendFormat": "探测异常",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
