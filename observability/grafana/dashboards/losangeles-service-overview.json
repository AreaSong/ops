{
  "uid": "losangeles-service-overview",
  "title": "服务总览",
  "description": "LosAngeles NOC 首页：KPI、容器健康/重启/OOM、服务健康表、短资源趋势。",
  "tags": [
    "LosAngeles",
    "overview",
    "noc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "容器部署与重建",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(docker_container_started_at_timestamp_seconds[75s]) > 0",
        "step": "60s",
        "titleFormat": "部署/重建 {{name}}",
        "tagKeys": "service,name"
      },
      {
        "name": "容器自动重启",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "increase(docker_container_restart_count[75s]) > 0",
        "step": "60s",
        "titleFormat": "自动重启 {{name}}",
        "tagKeys": "service,name"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "LosAngeles 看板",
      "tags": [
        "LosAngeles"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "全局 KPI",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
