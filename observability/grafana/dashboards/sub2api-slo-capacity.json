{
  "uid": "sub2api-slo-capacity",
  "title": "Sub2API SLO 与容量",
  "tags": [
    "LosAngeles",
    "capacity",
    "nav-runtime",
    "slo",
    "sub2api"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "journey",
        "label": "SLO 链路",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(service:synthetic_journey_success:ratio{service=\"sub2api\"}, journey)",
        "definition": "label_values(service:synthetic_journey_success:ratio{service=\"sub2api\"}, journey)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "SLO 概览",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "30 天合成可用性",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "last_over_time(service:synthetic_availability:ratio_30d{service=\"sub2api\",journey=~\"$journey\"}[2h]) and on(service, journey) (last_over_time(service:synthetic_slo_coverage:ratio_30d{service=\"sub2api\",journey=~\"$journey\"}[2h]) >= 0.95)",
          "legendFormat": "{{journey}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "noValue": "预热中",
          "links": [
            {
              "title": "查看 SLO 告警",
              "url": "/alerting/list?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "30 天观测覆盖率",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "last_over_time(service:synthetic_slo_coverage:ratio_30d{service=\"sub2api\",journey=~\"$journey\"}[2h])",
          "legendFormat": "{{journey}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "noValue": "无数据"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "30 天错误预算剩余",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "last_over_time(service:synthetic_error_budget_remaining:ratio_30d{service=\"sub2api\",journey=~\"$journey\"}[2h]) and on(service, journey) (last_over_time(service:synthetic_slo_coverage:ratio_30d{service=\"sub2api\",journey=~\"$journey\"}[2h]) >= 0.95)",
          "legendFormat": "{{journey}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          },
          "noValue": "尚未生效",
          "links": [
            {
              "title": "查看 SLO 告警",
              "url": "/alerting/list?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5 分钟燃烧率",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "expr": "service:synthetic_burn_rate:ratio_5m{service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "业务链路",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 5,
      "type": "state-timeline",
      "title": "业务链路探测状态",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "probe_success{scope=\"business\",service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}} / {{check}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "alignValue": "left",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "合成 SLO 燃烧窗口",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "service:synthetic_burn_rate:ratio_5m{service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}} 5m",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "service:synthetic_burn_rate:ratio_30m{service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}} 30m",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "service:synthetic_burn_rate:ratio_1h{service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}} 1h",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "service:synthetic_burn_rate:ratio_6h{service=\"sub2api\",journey=~\"$journey\"}",
          "legendFormat": "{{journey}} 6h",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sub2API 业务症状",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "expr": "business_http_5xx_last_5m{service=\"sub2api\"}",
          "legendFormat": "HTTP 5xx",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "business_http_slow_requests_last_5m{service=\"sub2api\",threshold=\"2s\"}",
          "legendFormat": "慢请求 ≥ 2 秒",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sub2api_no_available_account_events_last_5m",
          "legendFormat": "无可用账号",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "links": [
            {
              "title": "进入应用健康",
              "url": "/d/losangeles-app-health/losangeles-app-health?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "依赖与容量",
      "collapsed": true,
      "panels": [
        {
          "id": 8,
          "type": "timeseries",
          "title": "PostgreSQL 与 Redis 饱和度",
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 5
          },
          "targets": [
            {
              "expr": "sum by (instance) (pg_stat_activity_count{service=\"sub2api\"}) / clamp_min(max by (instance) (pg_settings_max_connections{service=\"sub2api\"}), 1)",
              "legendFormat": "PostgreSQL 连接 {{instance}}",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "expr": "redis_memory_used_bytes{service=\"sub2api\"} / clamp_min(redis_memory_max_bytes{service=\"sub2api\"}, 1)",
              "legendFormat": "Redis 内存 {{instance}}",
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "max": 1,
              "links": [
                {
                  "title": "进入数据库与缓存",
                  "url": "/d/losangeles-datastores/losangeles-datastores?${__url_time_range}",
                  "targetBlank": false
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "id": 9,
          "type": "timeseries",
          "title": "探测延迟",
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 5
          },
          "targets": [
            {
              "expr": "probe_duration_seconds{scope=\"business\",service=\"sub2api\",journey=~\"$journey\"}",
              "legendFormat": "{{journey}} / {{check}}",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "min": 0
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "依赖错误",
          "gridPos": {
            "x": 0,
            "y": 5,
            "w": 12,
            "h": 5
          },
          "targets": [
            {
              "expr": "increase(pg_stat_database_deadlocks{service=\"sub2api\"}[5m])",
              "legendFormat": "PostgreSQL 死锁 {{instance}}",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "expr": "increase(redis_rejected_connections_total{service=\"sub2api\"}[5m])",
              "legendFormat": "Redis 拒绝连接 {{instance}}",
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "min": 0,
              "links": [
                {
                  "title": "进入数据库与缓存",
                  "url": "/d/losangeles-datastores/losangeles-datastores?${__url_time_range}",
                  "targetBlank": false
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "Sub2API 容器饱和度",
          "gridPos": {
            "x": 12,
            "y": 5,
            "w": 12,
            "h": 5
          },
          "targets": [
            {
              "expr": "docker_container_cpu_limit_usage_ratio{name=\"sub2api\"}",
              "legendFormat": "CPU / 限额",
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "expr": "docker_container_memory_usage_ratio{name=\"sub2api\"}",
              "legendFormat": "内存 / 限额",
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "expr": "docker_container_pids_usage_ratio{name=\"sub2api\"}",
              "legendFormat": "PID / 限额",
              "refId": "C",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "links": [
                {
                  "title": "进入服务总览",
                  "url": "/d/losangeles-service-overview/losangeles-service-overview?${__url_time_range}",
                  "targetBlank": false
                }
              ]
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      }
    }
  ],
