{
  "uid": "sub2api-slo-capacity",
  "title": "Sub2API SLO and Capacity",
  "tags": [
    "LosAngeles",
    "sub2api",
    "slo",
    "capacity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "30d synthetic availability",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "service:synthetic_availability:ratio_30d{service=\"sub2api\"}",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.99},
              {"color": "green", "value": 0.999}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "30d observation coverage",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "service:synthetic_slo_coverage:ratio_30d{service=\"sub2api\"}",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "green", "value": 0.95}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "30d error budget remaining",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "service:synthetic_error_budget_remaining:ratio_30d{service=\"sub2api\"}",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.25},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "5m burn rate",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
      "targets": [
        {
          "expr": "service:synthetic_burn_rate:ratio_5m{service=\"sub2api\"}",
          "legendFormat": "{{journey}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 6},
              {"color": "red", "value": 14.4}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Business journey probe success",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "probe_success{scope=\"business\",service=\"sub2api\"}",
          "legendFormat": "{{journey}} / {{check}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Synthetic SLO burn windows",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "service:synthetic_burn_rate:ratio_5m{service=\"sub2api\"}",
          "legendFormat": "{{journey}} 5m",
          "refId": "A"
        },
        {
          "expr": "service:synthetic_burn_rate:ratio_1h{service=\"sub2api\"}",
          "legendFormat": "{{journey}} 1h",
          "refId": "B"
        },
        {
          "expr": "service:synthetic_burn_rate:ratio_6h{service=\"sub2api\"}",
          "legendFormat": "{{journey}} 6h",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "sub2api business symptoms",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "business_http_5xx_last_5m{service=\"sub2api\"}",
          "legendFormat": "HTTP 5xx",
          "refId": "A"
        },
        {
          "expr": "business_http_slow_requests_last_5m{service=\"sub2api\",threshold=\"2s\"}",
          "legendFormat": "slow >=2s",
          "refId": "B"
        },
        {
          "expr": "sub2api_no_available_account_events_last_5m",
          "legendFormat": "no available account",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Postgres and Redis saturation",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (instance) (pg_stat_activity_count{service=\"sub2api\"}) / clamp_min(max by (instance) (pg_settings_max_connections{service=\"sub2api\"}), 1)",
          "legendFormat": "Postgres connections {{instance}}",
          "refId": "A"
        },
        {
          "expr": "redis_memory_used_bytes{service=\"sub2api\"} / clamp_min(redis_memory_max_bytes{service=\"sub2api\"}, 1)",
          "legendFormat": "Redis memory {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Probe latency",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "probe_duration_seconds{scope=\"business\",service=\"sub2api\"}",
          "legendFormat": "{{journey}} / {{check}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dependency errors",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "increase(pg_stat_database_deadlocks{service=\"sub2api\"}[5m])",
          "legendFormat": "Postgres deadlocks {{instance}}",
          "refId": "A"
        },
        {
          "expr": "increase(redis_rejected_connections_total{service=\"sub2api\"}[5m])",
          "legendFormat": "Redis rejected {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "sub2api container saturation",
      "gridPos": {"x": 0, "y": 30, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "docker_container_cpu_limit_usage_ratio{name=\"sub2api\"}",
          "legendFormat": "CPU / limit",
          "refId": "A"
        },
        {
          "expr": "docker_container_memory_usage_ratio{name=\"sub2api\"}",
          "legendFormat": "memory / limit",
          "refId": "B"
        },
        {
          "expr": "docker_container_pids_usage_ratio{name=\"sub2api\"}",
          "legendFormat": "PIDs / limit",
          "refId": "C"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    }
  ]
}
