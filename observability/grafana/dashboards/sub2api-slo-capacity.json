{
  "uid": "sub2api-slo-capacity",
  "title": "Sub2API SLO 与容量",
  "tags": [
    "LosAngeles",
    "sub2api",
    "slo",
    "capacity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "SLO 服务",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(service:synthetic_journey_success:ratio, service)",
        "definition": "label_values(service:synthetic_journey_success:ratio, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "sub2api"
          ],
          "value": [
            "sub2api"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "journey",
        "label": "SLO 链路",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(service:synthetic_journey_success:ratio{service=~\"$service\"}, journey)",
        "definition": "label_values(service:synthetic_journey_success:ratio{service=~\"$service\"}, journey)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
