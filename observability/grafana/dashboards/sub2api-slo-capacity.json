  "annotations": {
    "list": [
      {
        "name": "Sub2API 部署与重建",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(docker_container_started_at_timestamp_seconds{service=\"sub2api\"}[75s]) > 0",
        "step": "60s",
        "titleFormat": "Sub2API 部署/重建 {{name}}",
        "tagKeys": "service,name"
      },
      {
        "name": "Sub2API 自动重启",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "increase(docker_container_restart_count{service=\"sub2api\"}[75s]) > 0",
        "step": "60s",
        "titleFormat": "Sub2API 自动重启 {{name}}",
        "tagKeys": "service,name"
      }
    ]
  }
