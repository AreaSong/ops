    {
      "id": 25,
      "type": "table",
      "title": "各服务 HTTP 质量",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "expr": "daily_ops_audit_http_error_ratio",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "错误率",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "daily_ops_audit_http_slow_requests",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "慢请求",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "daily_ops_audit_http_unique_clients",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "独立客户端",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "daily_ops_audit_http_bytes_sent",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "响应流量",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "threshold": true,
              "threshold 1": true,
              "threshold 2": true,
              "threshold 3": true,
              "threshold 4": true
            },
            "renameByName": {
              "service": "服务",
              "Value": "错误率",
              "Value #A": "错误率",
              "Value #B": "慢请求",
              "Value #C": "独立客户端",
              "Value #D": "响应流量"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "错误率"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.001
                    },
                    {
                      "color": "red",
                      "value": 0.01
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "响应流量"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
