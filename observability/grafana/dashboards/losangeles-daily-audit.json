{
  "uid": "losangeles-daily-audit",
  "title": "每日运维审计",
  "tags": [
    "LosAngeles",
    "audit",
    "daily"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 12,
      "type": "row",
      "title": "日报概览",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "日报生成距今",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "(time() - daily_ops_audit_last_success_timestamp) / 3600",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 小时",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 26
              },
              {
                "color": "red",
                "value": 28
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "日报异常汇总",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "daily_ops_audit_findings",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "数据采集与邮件",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "daily_ops_audit_data_source_failures",
          "legendFormat": "数据源失败",
          "refId": "A"
        },
        {
          "expr": "daily_ops_audit_delivery{state=\"attempted\"}",
          "legendFormat": "邮件已尝试",
          "refId": "B"
        },
        {
          "expr": "daily_ops_audit_delivery{state=\"accepted\"}",
          "legendFormat": "邮件已接受",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "流量与请求",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "每日主机网络流量",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_network_bytes",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "receive"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "接收"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "transmit"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "发送"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "每日 HTTP 请求量",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_http_requests",
          "legendFormat": "{{service}} {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "每日错误请求（4xx / 5xx）",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_http_requests{status_class=~\"4xx|5xx\"}",
          "legendFormat": "{{service}} {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "每日请求延迟分位数",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_http_latency_seconds{percentile=~\"p50|p95|p99\"}",
          "legendFormat": "{{service}} {{percentile}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "安全与备份",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "每日安全事件",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_security_events",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fail2ban_bans"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Fail2ban 封禁"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fail2ban_unbans"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Fail2ban 解封"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ssh_accepted"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SSH 登录成功"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ssh_failed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SSH 登录失败"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ssh_invalid_user"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SSH 无效用户"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sudo_commands"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "sudo 命令"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ufw_blocks"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "UFW 拦截"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "备份与容器异常",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "daily_ops_audit_backup_issues",
          "legendFormat": "备份 {{type}}",
          "refId": "A"
        },
        {
          "expr": "daily_ops_audit_expected_containers_down",
          "legendFormat": "预期容器未运行",
          "refId": "B"
        },
        {
          "expr": "daily_ops_audit_runtime_issues",
          "legendFormat": "运行态 {{type}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "backup missing"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "备份缺失"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup stale"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "备份过期"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup r2_missing"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R2 备份缺失"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup r2_stale"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R2 备份过期"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup r2_verify_missing"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R2 验证缺失"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup r2_verify_stale"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "R2 验证过期"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup set_missing"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "完整备份集缺失"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "backup set_stale"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "完整备份集过期"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "expected containers down"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "预期容器未运行"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runtime docker_unhealthy"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Docker 容器异常"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runtime node_exporter_down"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Node Exporter 不可用"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runtime systemd_failed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "systemd 单元失败"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runtime ufw_inactive"
            },
            "properties": [
              {
                "id": "displayName",
