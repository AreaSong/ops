          "expr": "process_resident_memory_bytes{job=~\"grafana|alertmanager|blackbox_exporter|loki\"}",
          "legendFormat": "{{job}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
