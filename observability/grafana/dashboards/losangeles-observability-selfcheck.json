    {
      "id": 105,
      "type": "row",
      "title": "核心组件自监控",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "组件抓取状态",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "min(up{job=\"grafana\"}) or on() vector(0)",
          "legendFormat": "Grafana",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "min(up{job=\"alertmanager\"}) or on() vector(0)",
          "legendFormat": "Alertmanager",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "min(up{job=\"blackbox_exporter\"}) or on() vector(0)",
          "legendFormat": "Blackbox",
