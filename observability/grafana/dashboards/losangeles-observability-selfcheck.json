    {
      "id": 15,
      "type": "stat",
      "title": "Loki Compactor 与保留清理",
      "gridPos": {
        "x": 18,
        "y": 25,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "min(loki_boltdb_shipper_compactor_running{job=\"loki\"}) or on() vector(0)",
          "legendFormat": "Compactor",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(loki_boltdb_shipper_retention_sweeper_marker_files_current{job=\"loki\"}) or on() vector(0)",
          "legendFormat": "Marker 队列",
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "((time() - loki_compactor_apply_retention_last_successful_run_timestamp_seconds{job=\"loki\"}) / 60 and loki_compactor_apply_retention_last_successful_run_timestamp_seconds{job=\"loki\"} > 0) or on() vector(0)",
          "legendFormat": "距保留成功",
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum(increase(loki_boltdb_shipper_retention_sweeper_marker_files_deleted_total{job=\"loki\"}[1h])) or on() vector(0)",
          "legendFormat": "1 小时删除",
          "instant": true,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "异常",
                        "color": "red"
                      },
                      "1": {
                        "text": "正常",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
