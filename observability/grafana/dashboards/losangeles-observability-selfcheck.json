      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Alertmanager 告警与通知",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(alertmanager_alerts{job=\"alertmanager\",state=\"active\"}) or on() vector(0)",
          "legendFormat": "活跃告警",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
