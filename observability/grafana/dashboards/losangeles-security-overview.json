{
  "uid": "losangeles-security-overview",
  "title": "LosAngeles Security Overview",
  "tags": [
    "LosAngeles",
    "security",
    "nginx",
    "ssh"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "UFW enabled",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "ufw_enabled",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Security metrics age",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "(time() - security_metrics_last_success_timestamp) / 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SSH login events 24h",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ssh_failed_login_last_24h",
          "legendFormat": "failed",
          "refId": "A"
        },
        {
          "expr": "ssh_invalid_user_last_24h",
          "legendFormat": "invalid user",
          "refId": "B"
        },
        {
          "expr": "ssh_accepted_login_last_24h",
          "legendFormat": "accepted",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fail2ban sshd state",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "fail2ban_currently_failed{jail=\"sshd\"}",
          "legendFormat": "currently failed",
          "refId": "A"
        },
        {
          "expr": "fail2ban_currently_banned{jail=\"sshd\"}",
          "legendFormat": "currently banned",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Nginx requests by status class 5m",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "nginx_http_requests_last_5m",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Nginx errors 5m",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "nginx_http_requests_last_5m{status_class=\"4xx\"}",
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "expr": "nginx_http_requests_last_5m{status_class=\"5xx\"}",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Recent Fail2ban Ban / Unban events",
      "description": "Shows raw Fail2ban sshd Ban and Unban log lines, including source IP addresses.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{job=\"fail2ban\", host=\"LosAngeles\"} |~ \" (Ban|Unban) \"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Fail2ban enriched IP intelligence",
      "description": "Shows Fail2ban Ban and Unban events enriched with country, ASN, BGP prefix and network organization.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{job=\"fail2ban_enriched\", host=\"LosAngeles\"} | json | line_format \"{{.event_ts}} {{.action}} jail={{.jail}} ip={{.ip}} country={{.country}} asn={{.asn}} prefix={{.bgp_prefix}} org={{.as_name}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
