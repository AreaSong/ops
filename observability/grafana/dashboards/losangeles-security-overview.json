      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Nginx 错误（5 分钟）",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "nginx_http_requests_last_5m{status_class=\"4xx\"}",
          "legendFormat": "4xx",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
