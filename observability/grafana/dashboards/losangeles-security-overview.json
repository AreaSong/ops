      "title": "Nginx 请求（按状态码，5 分钟）",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "nginx_http_requests_last_5m",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
