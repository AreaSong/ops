    {
      "id": 16,
      "type": "row",
      "title": "Fail2ban 事件",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "最近 Fail2ban 封禁与解封事件",
      "description": "Shows raw Fail2ban sshd Ban and Unban log lines, including source IP addresses.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"fail2ban\", host=\"LosAngeles\"} |~ \" (Ban|Unban) \"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Fail2ban IP 情报",
      "description": "Shows Fail2ban Ban and Unban events enriched with country, ASN, BGP prefix and network organization.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"fail2ban_enriched\", host=\"LosAngeles\"} | json | line_format \"{{.event_ts}} {{.action}} jail={{.jail}} ip={{.ip}} country={{.country}} asn={{.asn}} prefix={{.bgp_prefix}} org={{.as_name}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
