{
  "uid": "losangeles-certificates-cloudflare",
  "title": "TLS 与 Cloudflare 治理",
  "tags": [
    "LosAngeles",
    "certificates",
    "cloudflare",
    "nav-reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 6,
      "type": "row",
      "title": "证书状态",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "源站证书剩余天数",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "expr": "cloudflare_origin_cert_days_until_expiry{service=\"host\"}",
          "legendFormat": "{{cert}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 天",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 180
              }
            ]
          },
          "links": [
            {
              "title": "查看服务与证书告警",
              "url": "/alerting/list?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "源站证书检查状态",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "expr": "cloudflare_origin_cert_check_success{service=\"host\"}",
          "legendFormat": "{{cert}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "证书指标新鲜度",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "expr": "time() - cloudflare_origin_cert_metrics_last_run_timestamp{service=\"host\"}",
          "legendFormat": "距上次成功",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 7200
              },
              {
                "color": "red",
                "value": 10800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "证书到期趋势",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "源站证书到期趋势",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "cloudflare_origin_cert_days_until_expiry{service=\"host\"}",
          "legendFormat": "{{cert}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 天"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "公开 TLS 证书剩余天数",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "(probe_ssl_earliest_cert_expiry{job=~\"blackbox_https|blackbox_app_https|blackbox_business_.*_https\"} - time()) / 86400",
          "legendFormat": "{{service}} {{check}} {{target}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: 天"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 25,
      "type": "row",
      "title": "Cloudflare 代理 IP 治理",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Cloudflare IP 清单检查",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 3
      },
      "targets": [
        {
          "expr": "cloudflare_ip_ranges_check_success{service=\"host\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Cloudflare IP 检查距今",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 3
      },
      "targets": [
        {
          "expr": "time() - cloudflare_ip_ranges_last_run_timestamp{service=\"host\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Cloudflare 托管与官方 CIDR",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "cloudflare_ip_ranges_match{service=\"host\"}",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "instance": true,
              "job": true,
              "__name__": true,
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "一致状态"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ],
  "description": "源站证书、公开 TLS 证书和 Cloudflare 相关检查。",
