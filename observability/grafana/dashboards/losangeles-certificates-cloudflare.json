        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "blue",
        "expr": "changes(cloudflare_ip_ranges_last_run_timestamp{service=\"host\"}[20m]) > 0",
