{
  "uid": "losangeles-xray-traffic-audit",
  "title": "流量审计",
  "tags": [
    "LosAngeles",
    "x-ui",
    "xray",
    "traffic"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "字节流量（按服务分类）",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "各分类上行速率（5 分钟）",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(xray_outbound_traffic_bytes_total{direction=\"uplink\"}[5m])",
          "legendFormat": "{{tag}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "各分类下行速率（5 分钟）",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(xray_outbound_traffic_bytes_total{direction=\"downlink\"}[5m])",
          "legendFormat": "{{tag}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "累计流量（按分类与方向）",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "xray_outbound_traffic_bytes_total",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "tag": "服务分类",
              "direction": "方向",
              "Value": "累计字节"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "审计采集新鲜度（分钟）",
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "expr": "(time() - xray_traffic_metrics_last_run_timestamp) / 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "采集健康状态",
      "gridPos": {
        "x": 20,
        "y": 9,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "expr": "xray_traffic_metrics_check_success",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "访问目的地（完整清单）",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "最近访问记录（域名 / 用户 / 出站分类）",
      "description": "Xray access log lines: source, accepted destination domain:port, inbound, outbound tag and client email.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 12
      },
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{job=\"xray_access\", host=\"LosAngeles\"}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "fieldConfig": {
        "defaults": {}
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "访问频次统计",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "各出站分类连接速率（按分类，5 分钟）",
      "description": "Connection acceptance rate per outbound tag, derived from Xray access log volume in Loki.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 9
      },
      "datasource": "Loki",
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (outbound) (rate({job=\"xray_access\", host=\"LosAngeles\"} |= \"accepted\" [5m]))",
          "legendFormat": "{{outbound}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      }
    }
  ],
  "description": "x-ui/xray 节点流量审计：按服务分类的字节用量（Prometheus）与完整访问目的地清单（Loki）。",
  "editable": false,
  "graphTooltip": 1
}
