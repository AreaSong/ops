{
  "uid": "losangeles-xray-traffic-audit",
  "title": "流量审计",
  "tags": [
    "LosAngeles",
    "nav-governance",
    "traffic",
    "x-ui",
    "xray"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "字节流量（按服务分类）",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "各分类上行速率（5 分钟）",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(xray_outbound_traffic_bytes_total{direction=\"uplink\",tag=~\"$outbound\"}[5m])",
          "legendFormat": "{{tag}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "各分类下行速率（5 分钟）",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(xray_outbound_traffic_bytes_total{direction=\"downlink\",tag=~\"$outbound\"}[5m])",
          "legendFormat": "{{tag}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "本时段流量（按分类与方向）",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(xray_outbound_traffic_bytes_total{tag=~\"$outbound\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "tag": "服务分类",
              "direction": "方向",
              "Value": "本时段字节"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "审计采集新鲜度（分钟）",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "(time() - xray_traffic_metrics_last_run_timestamp) / 60",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "采集健康状态",
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "xray_traffic_metrics_check_success",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "异常",
                  "color": "red"
                },
                "1": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ],
          "links": [
            {
              "title": "查看活动告警",
              "url": "/alerting/list?${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "访问目的地原始日志（按需）",
      "collapsed": true,
      "panels": [
        {
          "id": 8,
          "type": "logs",
          "title": "最近访问记录（域名 / 用户 / 出站分类）",
          "description": "Xray access log lines: source, accepted destination domain:port, inbound, outbound tag and client email.",
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 24,
            "h": 8
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "datasource": {
                "type": "loki",
                "uid": "loki"
              },
              "expr": "{job=\"xray_access\", host=\"LosAngeles\", outbound=~\"$outbound\"} | regexp `email: (?P<email>\\S+)` | email=~\"$email\"",
              "queryType": "range",
              "refId": "A"
            }
          ],
          "options": {
            "dedupStrategy": "none",
            "enableLogDetails": true,
            "prettifyLogMessage": false,
            "showCommonLabels": false,
            "showLabels": false,
            "showTime": true,
            "sortOrder": "Descending",
            "wrapLogMessage": true
          },
          "fieldConfig": {
            "defaults": {}
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "访问频次统计",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "各出站分类连接速率（按分类，5 分钟）",
      "description": "Connection acceptance rate per outbound tag, derived from Xray access log volume in Loki.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outbound) (rate({job=\"xray_access\", host=\"LosAngeles\", outbound=~\"$outbound\"} |~ \"email:\" [5m]))",
          "legendFormat": "{{outbound}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 240
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Top 目的地域名（按连接次数）",
      "description": "Client connections grouped by sniffed destination domain, ranked by count over the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(20, sum by (dest) (count_over_time({job=\"xray_access\", host=\"LosAngeles\", outbound=~\"$outbound\"} | regexp `email: (?P<email>\\S+)` | email=~\"$email\" | regexp `accepted \\w+:(?P<dest>[^:\\s]+):[0-9]+` | dest != \"\" [$__range])))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "dest": "目的地",
              "Value": "连接次数"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "连接次数",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "用户维度",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "每用户流量速率（5 分钟）",
      "description": "Per-user uplink/downlink byte rate from xray user>>>traffic counters.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (email) (rate(xray_user_traffic_bytes_total{direction=\"uplink\",email=~\"$email\"}[5m]))",
          "legendFormat": "{{email}} 上行",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (email) (rate(xray_user_traffic_bytes_total{direction=\"downlink\",email=~\"$email\"}[5m]))",
          "legendFormat": "{{email}} 下行",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 220
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "本时段每用户流量（按方向）",
      "description": "increase() over the selected range, robust to xray restarts.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "increase(xray_user_traffic_bytes_total{email=~\"$email\"}[$__range])",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "email": "用户",
              "direction": "方向",
              "Value": "字节量"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "方向"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "uplink": {
                        "text": "上行"
                      },
                      "downlink": {
                        "text": "下行"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "字节量",
            "desc": true
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "用户 × 出站分类连接数（本时段）",
      "description": "Access-log connections grouped by user and outbound bucket over the selected range.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(50, sum by (email, outbound) (count_over_time({job=\"xray_access\", host=\"LosAngeles\", outbound=~\"$outbound\"} | regexp `email: (?P<email>\\S+)` | email=~\"$email\" [$__range])))",
          "format": "table",
          "instant": true,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "email": "用户",
              "outbound": "出站分类",
              "Value": "连接次数"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "连接次数",
            "desc": true
          }
        ]
      }
    }
  ],
  "description": "x-ui/xray 节点流量审计：按服务分类的字节用量（Prometheus）与完整访问目的地清单（Loki）。",
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "xray 告警",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{service=\"x-ui\",alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "tagKeys": "severity,alertname"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "outbound",
        "label": "出站分类",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(xray_outbound_traffic_bytes_total, tag)",
        "definition": "label_values(xray_outbound_traffic_bytes_total, tag)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "email",
        "label": "用户",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(xray_user_traffic_bytes_total, email)",
        "definition": "label_values(xray_user_traffic_bytes_total, email)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "运行",
      "tags": [
        "nav-runtime"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "可靠性",
      "tags": [
        "nav-reliability"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "dashboards",
      "asDropdown": true,
      "title": "安全与审计",
      "tags": [
        "nav-governance"
      ],
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "返回服务总览",
      "url": "/d/losangeles-service-overview/losangeles-service-overview",
      "icon": "dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "活动告警",
      "url": "/alerting/list",
      "icon": "bell",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true,
      "asDropdown": false
    },
    {
      "type": "link",
      "title": "静默管理",
      "url": "/alerting/silences",
      "icon": "pause",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": false,
      "asDropdown": false
    }
  ]
}
